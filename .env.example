# ==============================================================================
# VARIABLES DE ENTORNO PARA RENDER (DASHBOARD O .ENV)
# ESMERALDAS RESILIENTE 6B
# ==============================================================================

# 1. Configuración de Django
DEBUG=False
SECRET_KEY=cambiar-por-una-clave-secreta-larga-y-segura-en-produccion
ALLOWED_HOSTS=*

# 2. Orígenes Permitidos para CSRF y CORS
CSRF_TRUSTED_ORIGINS=https://*.onrender.com
CORS_ALLOW_ALL_ORIGINS=True

# 3. Base de Datos Espacial PostgreSQL + PostGIS (Aiven Cloud)
# En el Dashboard de Render, asigna tu Service URI completo de Aiven:
DATABASE_URL=postgres://avnadmin:TU_PASSWORD_AIVEN@dbesmeralda-resilieve-sistema-basededatos.f.aivencloud.com:24201/defaultdb?sslmode=require

# 4. Integración Meteorológica (OpenWeatherMap)
# Opcional (si se deja vacío, el sistema utiliza el servicio en vivo de Open-Meteo sin API key)
OPENWEATHERMAP_API_KEY=
OPENWEATHERMAP_BASE_URL=https://api.openweathermap.org/data/2.5

# 5. Coordenadas Centrales del Cantón Esmeraldas
ESMERALDAS_LAT=0.9681
ESMERALDAS_LON=-79.6582
