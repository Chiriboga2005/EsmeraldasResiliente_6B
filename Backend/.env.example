# ==============================================================================
# CONFIGURACIÓN DEL ENTORNO - SISTEMA DE RIESGOS ESMERALDAS
# ==============================================================================

# Entorno Django
DEBUG=True
SECRET_KEY=django-insecure-esmeraldas-resiliente-key-2026-geodjango-coe
ALLOWED_HOSTS=localhost,127.0.0.1,*

# Conexión a Base de Datos PostgreSQL + PostGIS (esmeraldas_db)
DB_ENGINE=django.contrib.gis.db.backends.postgis
DB_NAME=esmeraldas_db
DB_USER=postgres
DB_PASSWORD=tu_password_aqui
DB_HOST=localhost
DB_PORT=5432

# Integración Meteorológica (OpenWeatherMap)
# Obtén tu API key gratuita en: https://home.openweathermap.org/api_keys
OPENWEATHERMAP_API_KEY=tu_api_key_de_openweathermap_aqui
OPENWEATHERMAP_BASE_URL=https://api.openweathermap.org/data/2.5

# Coordenadas por defecto (Centro de la Ciudad de Esmeraldas)
ESMERALDAS_LAT=0.9681
ESMERALDAS_LON=-79.6582

# Configuración CORS (Permitir frontend Web y Móvil)
CORS_ALLOW_ALL_ORIGINS=True

